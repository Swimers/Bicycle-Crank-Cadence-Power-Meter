/dts-v1/;

#include <nordic/nrf52832_qfaa.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "cadence_sensor_nrf52832-pinctrl.dtsi"

/ {
	model = "Cadence Sensor V1.0 (nRF52832-QFAA)";
	compatible = "swimers,cadence-sensor";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	aliases {
		sw0 = &user_button;
	};

	buttons {
		compatible = "gpio-keys";

		user_button: user-button {
			gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	zephyr,user {
		sc7a20h-i2c = <&i2c0>;
		sc7a20h-address = <0x19>;
		/* Match the interrupt polarity selected in the sensor. */
		sc7a20h-int1-gpios = <&gpio0 13 0>;

		ads1220-spi = <&spi1>;
		ads1220-spi-max-frequency = <DT_FREQ_M(1)>;
		ads1220-spi-cpha;
		ads1220-drdy-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

		io-channels = <&adc 0>;
		bat-mon-full-ohms = <1720000>;
		bat-mon-output-ohms = <220000>;
		/* Use raw levels for these control lines until verified on hardware. */
		bat-mon-en-gpios = <&gpio0 6 0>;
		pmic-mode-gpios = <&gpio0 7 0>;
		pmic-iset-gpios = <&gpio0 8 0>;
		pmic-power-off-gpios = <&gpio0 22 0>;

		pwms = <&pwm0 0 PWM_USEC(250) PWM_POLARITY_NORMAL>;
	};
};

&gpio0 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&uicr {
	gpio-as-nreset;
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	cs-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
	};
};
