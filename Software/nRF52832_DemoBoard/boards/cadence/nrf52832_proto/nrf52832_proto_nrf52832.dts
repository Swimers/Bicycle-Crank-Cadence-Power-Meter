/dts-v1/;
#include <nordic/nrf52832_qfaa.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
/ {
    model = "NRF52832 3.3V Header Prototype";
    compatible = "cadence,nrf52832-proto";
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
    };
    aliases { sw0 = &user_button; };
    buttons {
        compatible = "gpio-keys";
        user_button: user-button {
            label = "SW5 user button";
            gpios = <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };
};
&gpio0 { status = "okay"; };
&gpiote { status = "okay"; };
&uicr {
    gpio-as-nreset;
    nfct-pins-as-gpios;
};
&reg { regulator-initial-mode = <NRF5X_REG_MODE_DCDC>; };
/* I2C0 and SPI1 use different peripheral instances. */
&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <100000>;
    pinctrl-0 = <&acc_default>;
    pinctrl-1 = <&acc_sleep>;
    pinctrl-names = "default", "sleep";
    sc7a20h: accelerometer@19 {
        compatible = "silan,sc7a20h";
        reg = <0x19>;
        int1-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
    };
};
&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&ads_default>;
    pinctrl-1 = <&ads_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
    ads1220: adc@0 {
        compatible = "cadence,ads1220-raw";
        reg = <0>;
        spi-max-frequency = <1000000>;
        spi-cpha;
        drdy-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
    };
};
&pinctrl {
    acc_default: acc-default {
        group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 14)>, <NRF_PSEL(TWIM_SCL, 0, 15)>; };
    };
    acc_sleep: acc-sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 14)>, <NRF_PSEL(TWIM_SCL, 0, 15)>;
            low-power-enable;
        };
    };
};

&pinctrl {
    ads_default: ads-default {
        group1 { psels = <NRF_PSEL(SPIM_SCK, 0, 7)>, <NRF_PSEL(SPIM_MOSI, 0, 8)>, <NRF_PSEL(SPIM_MISO, 0, 9)>; };
    };
    ads_sleep: ads-sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 7)>, <NRF_PSEL(SPIM_MOSI, 0, 8)>, <NRF_PSEL(SPIM_MISO, 0, 9)>;
            low-power-enable;
        };
    };
};
