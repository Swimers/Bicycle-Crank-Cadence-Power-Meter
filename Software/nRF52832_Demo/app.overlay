#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	chosen {
		zephyr,bt-hci = &bt_hci_sdc;
	};
};

/* BLE uses the integrated radio; it does not need GPIO pin routing. */
&radio {
	status = "okay";
};

&bt_hci_sdc {
	status = "okay";
};

&bt_hci_controller {
	status = "disabled";
};

/* Release the DK button pins used by the custom I2C bus. */
&button1 {
	status = "disabled";
};

&button2 {
	status = "disabled";
};

&pinctrl {
	cadence_i2c0_default: cadence_i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 15)>,
				<NRF_PSEL(TWIM_SDA, 0, 14)>;
		};
	};

	cadence_i2c0_sleep: cadence_i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 15)>,
				<NRF_PSEL(TWIM_SDA, 0, 14)>;
			low-power-enable;
		};
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&cadence_i2c0_default>;
	pinctrl-1 = <&cadence_i2c0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* SPI0 shares its peripheral instance with I2C0. */
&spi0 {
	status = "disabled";
};
